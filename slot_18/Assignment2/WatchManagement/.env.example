# [TODO-0.2] Copy to .env and fill in real values. Never commit .env.
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=change_me

# Published host port of the SQL Server container (1433 may be used by a local instance)
DB_HOST_PORT=14333

# At least 32 characters; MSAccount and the Gateway must share the same value
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_chars
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

ACCOUNT_SERVICE_URL=http://localhost:8081
BRAND_SERVICE_URL=http://localhost:8082
WATCH_SERVICE_URL=http://localhost:8083

SAGA_FAULT_INJECTION=true
